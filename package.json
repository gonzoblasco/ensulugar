{
  "name": "ensulugar",
  "version": "0.1.0",
  "description": "Tutor de cocina adaptativo con IA (BYOK). Cada receta es la semilla de una lección.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "bin": {
    "ensulugar": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:app\"",
    "dev:server": "tsx watch src/server.ts",
    "start:server": "node dist/server.js",
    "dev:app": "vite",
    "build:app": "vite build",
    "preview:app": "vite preview",
    "build:content": "tsx src/build/build.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "gray-matter": "^4.0.3",
    "marked": "^14.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/ui": "^2.1.9",
    "axe-core": "^4.12.1",
    "concurrently": "^10.0.4",
    "happy-dom": "^20.11.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vite": "^6.4.3",
    "vitest": "^2.1.9"
  }
}
