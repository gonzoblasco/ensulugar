# EnSuLugar — Configuración del proveedor LLM (BYOK)
# Copiá este archivo como .env y configurá tu proveedor.
# NUNCA commitees este archivo al repo.

# Elegí uno: ollama | openai | anthropic
LLM_PROVIDER=ollama

# Ollama local (default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-v4-flash

# OpenAI (si usás openai como provider)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (si usás anthropic como provider)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-haiku-20240307
